<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the whole UI; this window theme only sets system bar and splash basics. -->
    <style name="Theme.EasyLife" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="colorPrimary">@color/brand_teal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.EasyLife.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_teal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.EasyLife</item>
    </style>
</resources>
